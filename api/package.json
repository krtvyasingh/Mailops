{
  "name": "mailops-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:standalone": "tsx src/server.ts",
    "test": "tsx --test test/*.test.ts test/**/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "drizzle-orm": "^0.30.0",
    "hono": "^4.0.0",
    "nanoid": "^6.0.1",
    "postal-mime": "^2.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240222.0",
    "@types/node": "^26.6.2",
    "drizzle-kit": "^0.20.0",
    "tsx": "^4.23.13",
    "typescript": "^5.0.0",
    "wrangler": "^3.0.0"
  }
}
